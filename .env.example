POSTGRES_DB=kintai
POSTGRES_USER=kintai
POSTGRES_PASSWORD=change-me
IMAGE_TAG=latest

# Local file(default) example:
# TEMPLATE_SOURCE=/app/業務進捗報告_島.xlsx
# S3 ARN example:
TEMPLATE_SOURCE=arn:aws:s3:::dev--kintai--s3-709147558067-ap-northeast-1-an/業務進捗報告_島.xlsx

AWS_REGION=ap-northeast-1
# Optional for local docker compose execution when no IAM role is attached
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY_PREFIX=kintai
DOCKERHUB_USERNAME=your-dockerhub-username
